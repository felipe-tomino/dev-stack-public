# Dedicated headless browser for OMP.
if [ -z "${PUPPETEER_EXECUTABLE_PATH:-}" ]; then
    export PUPPETEER_EXECUTABLE_PATH=@HOME_SHELL@/.local/bin/agent-chromium
fi
# Prevent inherited OMP routing overrides from selecting the personal browser or Tern.
export PI_BROWSER_RELAY=0
export PI_BROWSER_TERN=0
