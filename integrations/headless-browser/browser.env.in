# Dedicated automation browser; migrate the previous local Chrome-for-Testing setup.
if [ -z "${PUPPETEER_EXECUTABLE_PATH:-}" ] || [ "${PUPPETEER_EXECUTABLE_PATH:-}" = @HOME_SHELL@/'Library/Application Support/AgentBrowsers/Google Chrome for Testing.app/Contents/MacOS/Google Chrome for Testing' ]; then
    export PUPPETEER_EXECUTABLE_PATH=@HOME_SHELL@/.local/bin/agent-chromium
fi
if [ -z "${PLAYWRIGHT_MCP_EXECUTABLE_PATH:-}" ] || [ "${PLAYWRIGHT_MCP_EXECUTABLE_PATH:-}" = @HOME_SHELL@/'Library/Application Support/AgentBrowsers/Google Chrome for Testing.app/Contents/MacOS/Google Chrome for Testing' ]; then
    export PLAYWRIGHT_MCP_EXECUTABLE_PATH=@HOME_SHELL@/.local/bin/agent-chromium
fi
