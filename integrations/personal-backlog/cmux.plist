<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.personal-backlog.cmux</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>@HOME@/.local/share/personal-backlog/cmux-summary.py</string>
        <string>--once</string>
    </array>
    <key>WorkingDirectory</key>
    <string>@HOME@/.local/share/personal-backlog</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>@HOME@</string>
        <key>PATH</key>
        <string>@HOME@/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>@HOME@/.local/state/personal-backlog/cmux-summary.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>@HOME@/.local/state/personal-backlog/cmux-summary.stderr.log</string>
</dict>
</plist>
